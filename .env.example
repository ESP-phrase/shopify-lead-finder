# Copy to .env and fill in your values. NEVER commit .env to git.

# Residential proxy (highly recommended — DDG/Brave/Google all rate-limit)
# Format: http://USER:PASS@HOST:PORT (URL-encode special chars)
PROXY_URL=

# Brave Search API — https://api-dashboard.search.brave.com/
BRAVE_API_KEY=

# Google Custom Search — https://programmablesearchengine.google.com/
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Proxy pool size (cap how many of proxies.txt to use — 0 = use all)
PROXY_POOL_SIZE=50

# Flask session secret — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production (FLASK_ENV=production); auto-generated in dev.
FLASK_SECRET=
FLASK_ENV=development

# Stripe (optional — without these, /checkout runs in test-mode)
# Get keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Webhook secret from https://dashboard.stripe.com/webhooks (after adding /stripe/webhook)
STRIPE_WEBHOOK_SECRET=
